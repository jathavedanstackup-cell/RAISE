// RAISE — core data model (CP1).
// See docs/production-plan.md Part 3 for the source schema sketch and
// docs/decisions.md for the modelling decisions that go beyond it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VisitStatus {
  draft
  confirmed
  kitchen_started
  table_set
  guest_arrived
  food_out
  completed
  cancelled
  no_show
}

enum TableStatus {
  free
  held
  seated
}

enum ConversationRole {
  customer
  system
}

/// Staff role within a single restaurant membership. Deliberately NOT a
/// column on User itself — see StaffMembership and docs/decisions.md
/// ("Staff <-> Restaurant shape").
enum StaffRole {
  owner
  foh
  kitchen
}

model Restaurant {
  id        String   @id @default(uuid(7))
  name      String
  timezone  String
  address   String
  phone     String
  /// { avgPrepBufferMinutes: number, tableHoldWindowMinutes: number, expoBufferMinutes: number }
  /// CP6 adds `expoBufferMinutes` (plate-to-table time added after the
  /// longest item's prep finishes, used for `food_out_target`) alongside
  /// CP1's original two keys -- flagged per Rule #4 in docs/decisions.md:
  /// the deck's worked example cannot reconcile `food_out_target` from
  /// `avgPrepBufferMinutes` alone, see the CP6 entry for the arithmetic.
  settings  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  menuItems        MenuItem[]
  tables           Table[]
  visits           Visit[]
  staffMemberships StaffMembership[]

  @@map("restaurants")
}

/// A staff account. Deliberately holds no restaurant_id or role itself —
/// those live on StaffMembership so one person can belong to more than one
/// restaurant with a distinct role at each, without a schema change when
/// CP13 (Phase 2 chains) arrives. See docs/decisions.md.
model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships StaffMembership[]

  @@map("users")
}

/// The user x restaurant x role join CP2 is built around. Not RLS-scoped by
/// a value derived from itself — every lookup is keyed by (userId,
/// restaurantId) from the request's route, so app.current_restaurant_id is
/// always known before this table is queried. See docs/decisions.md.
model StaffMembership {
  id           String    @id @default(uuid(7))
  userId       String    @map("user_id")
  restaurantId String    @map("restaurant_id")
  role         StaffRole
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
  @@map("staff_memberships")
}

/// Customer identity. Deliberately guest-first: phone + phoneVerifiedAt is
/// enough to exist and start a Visit; name/email are optional and collected
/// later. See docs/decisions.md (Part 8 Q4).
model Customer {
  id              String    @id @default(uuid(7))
  phone           String    @unique
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  name            String?
  email           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  visits Visit[]

  @@map("customers")
}

model MenuItem {
  id                String   @id @default(uuid(7))
  restaurantId      String   @map("restaurant_id")
  name              String
  description       String?
  /// Currency amount, 2 decimal places.
  price             Decimal  @db.Decimal(10, 2)
  prepTimeMinutes   Int      @map("prep_time_minutes")
  allergens         String[]
  modifiableOptions String[] @map("modifiable_options")
  available         Boolean  @default(true)
  category          String
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  visitItems VisitItem[]

  @@index([restaurantId])
  @@map("menu_items")
}

model Table {
  id           String      @id @default(uuid(7))
  restaurantId String      @map("restaurant_id")
  label        String
  seatsMin     Int         @map("seats_min")
  seatsMax     Int         @map("seats_max")
  status       TableStatus @default(free)
  features     String[]
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  visits     Visit[]

  @@index([restaurantId])
  @@map("tables")
}

model Visit {
  id           String @id @default(uuid(7))
  restaurantId String @map("restaurant_id")

  /// CP1 left this as a bare unvalidated string pending CP2's Customer
  /// model; now a real FK. Still nullable: nothing in CP2 requires a
  /// customer to exist before a Visit draft starts (CP4/CP5 own that flow).
  customerId String? @map("customer_id")

  /// CP4: nullable, not required — a draft Visit and its ConversationTurns
  /// must exist from the first greeting, before the customer has stated a
  /// party size (Part 4.1: greet, THEN ask party size/ETA). Was
  /// non-nullable through CP1-CP3, which never actually constructed a
  /// Visit row before both fields were known. See docs/decisions.md.
  partySize    Int?     @map("party_size")
  hasChild     Boolean  @default(false) @map("has_child")
  specialNeeds String[] @map("special_needs")

  /// CP4: nullable for the same reason as partySize above.
  arrivalEta         DateTime? @map("arrival_eta")
  arrivalConfirmedAt DateTime? @map("arrival_confirmed_at")

  tableId         String?   @map("table_id")
  tableAssignedAt DateTime? @map("table_assigned_at")

  /// CP6: the timing engine's current computed prediction, not an audit
  /// fact -- overwritten on every recompute (initial confirm, ETA drift,
  /// order-item change), unlike VisitStatusEvent which is append-only.
  /// Null until a confirmed visit has a table and items to compute from.
  /// "Awaiting accept" is deliberately NOT a persisted VisitStatus value:
  /// it's the derived condition `status = 'confirmed' AND
  /// kitchenStartTarget <= now()`, not a state a background job writes.
  /// See docs/decisions.md's CP6 entry.
  kitchenStartTarget DateTime? @map("kitchen_start_target")
  /// CP6: paired prediction for when food should hit the table. See
  /// docs/decisions.md for why this needs a second buffer distinct from
  /// `avgPrepBufferMinutes` to reconcile the deck's worked example.
  foodOutTarget      DateTime? @map("food_out_target")

  /// CP4: refreshed to now()+15m on every processed intake turn while
  /// status is still `draft`. A draft's own inactivity window — not the
  /// real post-confirmation Table hold, which is CP5's job (see
  /// docs/decisions.md, Part 8 Q3). Null once the draft is confirmed
  /// (CP5) or otherwise leaves `draft`; a draft never auto-confirms on
  /// expiry, it only triggers an honest recap-and-reconfirm turn.
  draftExpiresAt DateTime? @map("draft_expires_at")

  status VisitStatus @default(draft)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurant        Restaurant         @relation(fields: [restaurantId], references: [id])
  table             Table?             @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer          Customer?          @relation(fields: [customerId], references: [id])
  visitItems        VisitItem[]
  conversationTurns ConversationTurn[]
  notificationLogs  NotificationLog[]
  statusEvents      VisitStatusEvent[]

  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([tableId])
  @@index([customerId])
  @@map("visits")
}

/// Append-only audit trail of Visit.status transitions — the timeline shown
/// in deck slides 6/8, and what CP6 (timing engine) and CP8 (kitchen
/// display) are built against. A dedicated table rather than more flat
/// timestamp columns on Visit: it's genuinely append-only (a status can be
/// revisited or corrected without a schema change), and CP6's "recompute on
/// ETA drift" flow is naturally "insert another event", not "overwrite a
/// column". See docs/decisions.md.
model VisitStatusEvent {
  id           String      @id @default(uuid(7))
  restaurantId String      @map("restaurant_id")
  visitId      String      @map("visit_id")
  status       VisitStatus
  occurredAt   DateTime    @default(now()) @map("occurred_at")

  /// CP5: "who/when/how" — occurredAt already gives "when"; these three
  /// give "who" (actorType/actorId) and "how" (mechanism). All nullable
  /// because CP1-CP4 never actually wrote a VisitStatusEvent row (the
  /// full transition log is a CP6 deliverable per Part 6) — CP5 is the
  /// first checkpoint to populate them, for the one transition it owns
  /// (draft -> confirmed). e.g. actorType="customer", actorId=Customer.id,
  /// mechanism="explicit_confirm_endpoint".
  actorType String? @map("actor_type")
  actorId   String? @map("actor_id")
  mechanism String? @map("mechanism")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([visitId])
  @@map("visit_status_events")
}

model VisitItem {
  id            String   @id @default(uuid(7))
  restaurantId  String   @map("restaurant_id")
  visitId       String   @map("visit_id")
  menuItemId    String   @map("menu_item_id")
  quantity      Int      @default(1)
  /// Structured tags, not free text — e.g. ["spice_level:mild", "no_onion"].
  modifications String[]
  /// Structured tags, not free text — e.g. ["no_peanuts", "no_dairy"]. The
  /// kitchen display renders these as flagged lines (CP8), never buried in
  /// prose.
  allergyFlags  String[] @map("allergy_flags")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  visit    Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([restaurantId])
  @@index([visitId])
  @@index([menuItemId])
  @@map("visit_items")
}

model ConversationTurn {
  id              String           @id @default(uuid(7))
  restaurantId    String           @map("restaurant_id")
  visitId         String           @map("visit_id")
  role            ConversationRole
  transcript      String           @db.Text
  /// JSON patch applied to the Visit draft as a result of this turn.
  structuredDelta Json?            @map("structured_delta")
  createdAt       DateTime         @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([visitId])
  @@map("conversation_turns")
}

model NotificationLog {
  id           String    @id @default(uuid(7))
  restaurantId String    @map("restaurant_id")
  visitId      String    @map("visit_id")
  /// e.g. "sms" | "push" | "email" — kept as a plain string; CP9 owns the
  /// concrete channel set and provider wiring (Twilio SMS + web push per
  /// Part 2.2), not CP1.
  channel      String
  payload      Json
  sentAt       DateTime? @map("sent_at")
  /// e.g. "pending" | "sent" | "failed" — same reasoning as `channel`.
  status       String    @default("pending")
  createdAt    DateTime  @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([visitId])
  @@map("notification_logs")
}
