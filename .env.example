# Postgres — consumed by docker-compose.yml for local dev.
# DATABASE_URL is the connection string the API will use starting CP1
# (see docs/checkpoints/CP01-data-model.md); nothing reads it yet in CP0.
POSTGRES_USER=raise
POSTGRES_PASSWORD=raise
POSTGRES_DB=raise
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raise:raise@localhost:5432/raise

# API (apps/api) — port it listens on.
API_PORT=4000
