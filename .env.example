# Postgres — consumed by docker-compose.yml for local dev.
# DATABASE_URL is what apps/api (Prisma) connects with. If port 5432 is
# already taken on your machine, change POSTGRES_PORT and the port in
# DATABASE_URL together — don't just change one.
POSTGRES_USER=raise
POSTGRES_PASSWORD=raise
POSTGRES_DB=raise
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raise:raise@localhost:5432/raise

# CP2 — the API's *runtime* connection, as the restricted "raise_app" role
# created by the CP2 migration (NOT the superuser role above). DATABASE_URL
# stays the migration/seed connection. The app must never connect as the
# superuser role: superusers bypass Postgres Row Level Security outright,
# which would silently defeat every tenant-isolation policy. See
# docs/decisions.md. Dev/CI password matches the role name, same convention
# as POSTGRES_PASSWORD above — rotate before any non-local deployment.
APP_DATABASE_URL=postgresql://raise_app:raise_app@localhost:5432/raise

# API (apps/api) — port it listens on.
API_PORT=4000

# CP3 — apps/restaurant's server-only base URL for calling apps/api. No
# NEXT_PUBLIC_ prefix: the browser never talks to the API directly (see
# docs/decisions.md, "staff JWT storage") — only Next.js Route Handlers,
# Server Components, and Server Actions call this, server-side.
API_BASE_URL=http://localhost:4000

# CP7 — the one exception to "the browser never talks to the API
# directly" above: the WebSocket gateway. This is the only origin its
# upgrade handler accepts a connection from (docs/decisions.md's
# ticket-exchange entry). Not NEXT_PUBLIC_ — read server-side by apps/api.
RESTAURANT_APP_ORIGIN=http://localhost:3001

# CP2 — staff and customer JWTs are signed with separate secrets so a leak
# of one can't forge tokens for the other audience. Dev-only placeholder
# values below; generate real random secrets (e.g. `openssl rand -hex 32`)
# for any shared/deployed environment — never commit real secrets here.
JWT_STAFF_SECRET=dev-only-staff-secret-change-me
JWT_CUSTOMER_SECRET=dev-only-customer-secret-change-me

# CP4 pre-merge fix — the intake-draft capability token (see
# docs/decisions.md). A third, separate secret, same "leak of one can't
# forge the others" reasoning as the two above.
JWT_INTAKE_SECRET=dev-only-intake-secret-change-me

# CP2 — customer phone OTP. "dev" (default) never sends a real SMS and
# never requires live provider keys — see src/auth/otp/dev-otp.provider.ts.
# Set OTP_PROVIDER=twilio and the three TWILIO_* vars below only for an
# environment that should actually send SMS.
OTP_PROVIDER=dev
# Optional: force a deterministic code from the dev provider (used by CI's
# isolation/auth tests instead of reading a random code from server logs).
OTP_DEV_FIXED_CODE=424242
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=

# CP4 — voice/chat intake pipeline. Both default to a dev stub that calls
# no external provider and needs no key; set the *_PROVIDER var explicitly
# to opt into the real one (never set in CI — see docs/decisions.md, Part 8
# Q1/Q2, and apps/api/src/intake/*/dev-*.ts).
ASR_PROVIDER=dev
# DEEPGRAM_API_KEY=
LLM_PROVIDER=dev
# ANTHROPIC_API_KEY=

# CP4 — apps/customer's single v1 restaurant (see docs/decisions.md /
# CP3's "single-restaurant selection" precedent). Matches the demo seed's
# restaurant id. Public, unlike API_BASE_URL — a restaurant id is exactly
# what a real booking link/QR code already exposes.
NEXT_PUBLIC_DEMO_RESTAURANT_ID=demo-spice-route

# CP7 — the WebSocket URL apps/restaurant's dashboard connects to. Public
# by necessity: the browser opens this socket itself. It carries no
# credential — authentication is the short-lived single-use ticket minted
# server-side and passed as a subprotocol (see docs/decisions.md's CP7
# entry), never the staff JWT, which stays in the httpOnly cookie.
NEXT_PUBLIC_API_WS_URL=ws://localhost:4000


# CP9 — transactional SMS (booking confirmation). Separate from the CP2
# OTP provider on purpose: OTP goes through Twilio Verify, this goes
# through the Messaging API, and a deployment may reasonably want one
# without the other. Defaults to the dev stub, which logs instead of
# sending; SMS_PROVIDER=twilio must be set explicitly and additionally
# requires TWILIO_SMS_FROM_NUMBER alongside the TWILIO_ACCOUNT_SID /
# TWILIO_AUTH_TOKEN above.
SMS_PROVIDER=dev
# TWILIO_SMS_FROM_NUMBER=

# CP9 — how far a post-confirmation kitchen-start target must move before
# staff are alerted, in minutes. Unset means 10 (twice the seeded
# avgPrepBufferMinutes); see apps/api/src/notifications/drift-policy.ts
# and docs/decisions.md's CP9 entry. Present for tests and for tuning per
# deployment, not something a normal install needs to set.
# ETA_DRIFT_ALERT_THRESHOLD_MINUTES_OVERRIDE=10
