# Postgres — consumed by docker-compose.yml for local dev.
# DATABASE_URL is what apps/api (Prisma) connects with. If port 5432 is
# already taken on your machine, change POSTGRES_PORT and the port in
# DATABASE_URL together — don't just change one.
POSTGRES_USER=raise
POSTGRES_PASSWORD=raise
POSTGRES_DB=raise
POSTGRES_PORT=5432
DATABASE_URL=postgresql://raise:raise@localhost:5432/raise

# CP2 — the API's *runtime* connection, as the restricted "raise_app" role
# created by the CP2 migration (NOT the superuser role above). DATABASE_URL
# stays the migration/seed connection. The app must never connect as the
# superuser role: superusers bypass Postgres Row Level Security outright,
# which would silently defeat every tenant-isolation policy. See
# docs/decisions.md. Dev/CI password matches the role name, same convention
# as POSTGRES_PASSWORD above — rotate before any non-local deployment.
APP_DATABASE_URL=postgresql://raise_app:raise_app@localhost:5432/raise

# API (apps/api) — port it listens on.
API_PORT=4000

# CP2 — staff and customer JWTs are signed with separate secrets so a leak
# of one can't forge tokens for the other audience. Dev-only placeholder
# values below; generate real random secrets (e.g. `openssl rand -hex 32`)
# for any shared/deployed environment — never commit real secrets here.
JWT_STAFF_SECRET=dev-only-staff-secret-change-me
JWT_CUSTOMER_SECRET=dev-only-customer-secret-change-me

# CP2 — customer phone OTP. "dev" (default) never sends a real SMS and
# never requires live provider keys — see src/auth/otp/dev-otp.provider.ts.
# Set OTP_PROVIDER=twilio and the three TWILIO_* vars below only for an
# environment that should actually send SMS.
OTP_PROVIDER=dev
# Optional: force a deterministic code from the dev provider (used by CI's
# isolation/auth tests instead of reading a random code from server logs).
OTP_DEV_FIXED_CODE=424242
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
